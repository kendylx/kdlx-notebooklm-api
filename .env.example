# Bearer token bảo vệ mọi endpoint của bridge.
# BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài trước khi deploy production.
# Sinh nhanh: openssl rand -hex 32
NLM_BRIDGE_TOKEN=change-me-to-a-long-random-string

# Chỉ dùng trên máy local: thư mục chứa session `notebooklm login` trên host.
# Mặc định compose.yml dùng $HOME/.notebooklm — chỉ set khi login ở chỗ khác.
# NLM_HOST_DIR=/path/to/.notebooklm

# Bật mock mode để test contract không cần Google login:
# NLM_MOCK=1
